from telegram import Update, ReplyKeyboardMarkup
from telegram.ext import Application, CommandHandler, MessageHandler, ContextTypes, filters

# Укажите ваш токен, полученный от BotFather
TELEGRAM_TOKEN = '7641246237:AAFhNZEzHfj1QaBqVsjPO6g3R2UyCOPL1Vc'

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Привет! Я ваш помощник по уходу за волосами. Выберите опцию:",
        reply_markup=ReplyKeyboardMarkup(
            [['Записаться на приём'], ['Подобрать домашний уход'], ['Пройти тест'], ['Парикмахерская грамотность']],
            resize_keyboard=True
        )
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text
    if text == 'Записаться на приём':
        await update.message.reply_text("Пожалуйста, укажите ваш тип волос...")
    elif text == 'Подобрать домашний уход':
        await update.message.reply_text("Отправьте фото состава вашего средства...")
    elif text == 'Пройти тест':
        await update.message.reply_text("Пожалуйста, отправьте фото волос...")
    elif text == 'Парикмахерская грамотность':
        await update.message.reply_text("Какой раздел вас интересует?")
    else:
        await update.message.reply_text("Извините, я пока не понимаю эту команду.")

def main():
    application = Application.builder().token(TELEGRAM_TOKEN).build()

    application.add_handler(CommandHandler("start", start))
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    print("Бот запущен...")
    application.run_polling()

if __name__ == "__main__":
    main()